		(at 287.02 114.3 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "a91e4a77-9046-473e-af3b-c8442ad52186")
	)
	(text "LED1 (link, active high) -> green 20/19;\nLED2 (100M, active low) <- yellow 18/17 from VDD2A.\nStraps: REGOFF = 0 (internal 1.2 V on),\nnINTSEL = 1 (REF_CLK in). RBIAS 12k1 1%."
		(exclude_from_sim no)
		(at 287.02 160.02 0)
		(effects (font (size 1.27 1.27)) (justify left))
