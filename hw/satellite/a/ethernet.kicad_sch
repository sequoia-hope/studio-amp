	(text "Tune: 1-bit delta-sigma from ECP5 N4, 2 x (100k, 1u): 1.59 Hz poles,\n> 16 bits below 2 Hz; firmware clamps Vc to 0.3-3.0 V.\nFixed-XO fallback on the same land: fit the 0R to VDD, remove the series 0R."
		(exclude_from_sim no)
		(at 30.48 101.6 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "f66807e9-b934-45e8-8b41-cecacef51191")
	)
	(text "VCXO_CLK -> ECP5 P6 (LLC_GPLL0T_IN), shortest branch, no R.\nMCLK_Q -> block F's SN74LVC2G34 (MCLK_Q).\nVCXO within 10 mm of P6, RC filter beside Vc,\nnothing switching under the 1u caps."
		(exclude_from_sim no)
		(at 30.48 114.3 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "f09b5904-f46e-4c6a-941b-82afcf637de2")
	)
