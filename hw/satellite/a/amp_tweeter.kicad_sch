	(text "Fault latch: any OK low (OCP x 4, output short x 4, DC, AMP_ARM low) pulls FAULT_RAW low;\nSchmitt -> CLR -> Q (EN) low: both LMG1210 off in <= 216 ns (ramp) / ~51 ns (short).\nThe FPGA reads FAULT_n and re-arms with AMP_EN = 1 + an AMP_CLK edge. PRE tied high."
		(exclude_from_sim no)
		(at 200.66 337.82 0)
		(effects (font (size 1 1)) (justify left))
		(uuid "df6c2881-ed65-4878-b6fb-4ecd41cc4721")
