	(text "Clock-OK: retriggered by CO; Rext 10k / Cext 470p\n-> tw ~ 4.5 us (> 1.36 us CO period, <= 10 us).\nClock stops -> CLK_OK low within ~4.5 us -> SYNC low\n-> UCC2897A free-runs (590-708 kHz). B triggers on\nA falling edges with B held high."
		(exclude_from_sim no)
		(at 101.6 175.26 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "5ce1184a-a3ec-4329-b8c7-3b35d2ff1d2c")
