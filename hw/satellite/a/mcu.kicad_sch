	(text "Core regulator, RP2350 6.3.8 / Minimal board: CIN, L and COUT on the chip's side; copy the reference corner\n(chips/rp2350.md). L: AOTA-B201610S3R3 3.3u, dot to DVDD_RP, reference rotation (orientation changes Vout).\nDVDD_RP is the RP2350's own 1.1 V (internal regulator); it is not the FPGA's +1V1."
		(exclude_from_sim no)
		(at 22.86 17.78 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "ea0c2e61-6e97-47cb-9f37-23be0407e3a7")
